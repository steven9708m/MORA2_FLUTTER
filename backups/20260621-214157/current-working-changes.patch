+class _AttendanceDateGroup {
+  final DateTime date;
+  final String label;
+  final Map<String, int> countsByActivity;
+
+  const _AttendanceDateGroup({
+    required this.date,
+    required this.label,
+    required this.countsByActivity,
+  });
+}
